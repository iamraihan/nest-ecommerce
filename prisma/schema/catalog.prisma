// Catalog domain schema
// Main tables: products, product_options, product_option_values,
// product_variants, product_images
// Junction table: product_variant_option_values

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  PHYSICAL
  DIGITAL
  SERVICE
}

model Product {
  id String @id @default(uuid())

  // Core catalog data
  title            String        @db.VarChar(160)
  slug             String        @unique @db.VarChar(180)
  shortDescription String?       @map("short_description") @db.VarChar(320)
  description      String?
  brandId          String?       @map("brand_id")
  status           ProductStatus @default(DRAFT)
  productType      ProductType   @default(PHYSICAL) @map("product_type")

  // Merchandising and compliance
  currencyCode     String  @default("USD") @map("currency_code") @db.Char(3)
  isTaxable        Boolean @default(true) @map("is_taxable")
  requiresShipping Boolean @default(true) @map("requires_shipping")
  taxCode          String? @map("tax_code") @db.VarChar(64)
  countryOfOrigin  String? @map("country_of_origin") @db.VarChar(2)
  hsCode           String? @map("hs_code") @db.VarChar(32)

  // Search and SEO
  seoTitle       String?  @map("seo_title") @db.VarChar(70)
  seoDescription String?  @map("seo_description") @db.VarChar(160)
  tags           String[] @default([])

  // Extensibility
  metadata Json?

  // Audit ownership
  // Store user-service IDs as plain values so this remains microservice-safe.
  createdBy String @map("created_by") @db.VarChar(191)
  updatedBy String @map("updated_by") @db.VarChar(191)

  // Publication lifecycle
  publishedAt DateTime? @map("published_at")

  // Relations
  brand             Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categories        ProductCategory[]
  options           ProductOption[]
  variants          ProductVariant[]
  images            ProductImage[]

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([productType, status])
  @@index([brandId])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("products")
}

model Brand {
  id String @id @default(uuid())

  name        String  @unique @db.VarChar(120)
  slug        String  @unique @db.VarChar(140)
  description String?
  logoUrl     String? @map("logo_url") @db.VarChar(2048)
  isActive    Boolean @default(true) @map("is_active")

  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("brands")
}

model Category {
  id String @id @default(uuid())

  name        String  @db.VarChar(120)
  slug        String  @unique @db.VarChar(140)
  description String?
  parentId    String? @map("parent_id")
  isActive    Boolean @default(true) @map("is_active")
  position    Int     @default(0)

  parent   Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]        @relation("CategoryHierarchy")
  products ProductCategory[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([parentId, name])
  @@index([parentId, position])
  @@index([isActive])
  @@map("categories")
}

model ProductCategory {
  id String @id @default(uuid())

  productId  String @map("product_id")
  categoryId String @map("category_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductOption {
  id String @id @default(uuid())

  productId String @map("product_id")
  name      String @db.VarChar(80)
  position  Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, name])
  @@unique([productId, position])
  @@index([productId])
  @@map("product_options")
}

model ProductOptionValue {
  id String @id @default(uuid())

  optionId String @map("option_id")
  value    String @db.VarChar(80)
  position Int    @default(0)

  option   ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants ProductVariantOptionValue[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([optionId, value])
  @@unique([optionId, position])
  @@index([optionId])
  @@map("product_option_values")
}

model ProductVariant {
  id String @id @default(uuid())

  productId String @map("product_id")

  // Sellable line-item identity
  title String @db.VarChar(160)
  sku   String @unique @db.VarChar(80)

  // Optional commerce identifiers
  barcode String? @unique @db.VarChar(64)

  // Pricing
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  costPrice      Decimal? @map("cost_price") @db.Decimal(12, 2)

  // Inventory
  trackInventory    Boolean @default(true) @map("track_inventory")
  allowBackorder    Boolean @default(false) @map("allow_backorder")
  inventoryQuantity Int     @default(0) @map("inventory_quantity")
  lowStockThreshold Int?    @map("low_stock_threshold")

  // Fulfillment dimensions
  weightGrams Int?     @map("weight_grams")
  lengthCm    Decimal? @map("length_cm") @db.Decimal(8, 2)
  widthCm     Decimal? @map("width_cm") @db.Decimal(8, 2)
  heightCm    Decimal? @map("height_cm") @db.Decimal(8, 2)

  // Merchandising
  position  Int     @default(0)
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  // Extensibility
  metadata Json?

  product      Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues ProductVariantOptionValue[]
  images       ProductImage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, position])
  @@index([productId, isActive])
  @@index([productId, price])
  @@index([trackInventory, inventoryQuantity])
  @@map("product_variants")
}

model ProductVariantOptionValue {
  id String @id @default(uuid())

  variantId     String @map("variant_id")
  optionValueId String @map("option_value_id")

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([variantId, optionValueId])
  @@index([variantId])
  @@index([optionValueId])
  @@map("product_variant_option_values")
}

model ProductImage {
  id String @id @default(uuid())

  productId String  @map("product_id")
  variantId String? @map("variant_id")

  url       String  @db.VarChar(2048)
  altText   String? @map("alt_text") @db.VarChar(160)
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId, sortOrder])
  @@index([variantId])
  @@map("product_images")
}
